QNX's own GCC accepts #pragma pack(push, n)/pack(pop) like the Linux and BSD targets; the upstream i386 nto
config does not enable it, so packed structs (e.g. the A2I client headers) would silently get the default layout.
--- a/gcc/config/i386/nto.h	2026-11-16 22:24:54
+++ b/gcc/config/i386/nto.h	2026-11-16 22:24:54
@@ -92,1 +92,2 @@
 #define NO_IMPLICIT_EXTERN_C 1
+#define HANDLE_PRAGMA_PACK_PUSH_POP 1
