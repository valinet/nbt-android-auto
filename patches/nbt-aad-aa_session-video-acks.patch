+    void drainVideoAcks();           // session thread: video acks consumed or forced since the last drain
+    bool videoAcksPending();
+    pthread_mutex_t vack_mutex_;
+    bool vack_on_;                   // setDeferredVideoAcks
+    bool vack_session_;              // this session defers (guarded by vack_mutex_)
+    uint32_t vack_outstanding_;      // frames received, not acked yet (guarded)
+    uint32_t vack_consumed_;         // frames the consumer reported, not acked yet (guarded)
+    uint32_t vack_credit_;           // frames acked by force whose report is still to come (guarded)
+    double vack_oldest_s_;           // when the oldest outstanding frame arrived (guarded)
+    uint32_t vack_forced_, vack_force_runs_, vack_acked_;   // stats (guarded)
