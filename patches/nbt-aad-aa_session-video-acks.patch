+}
+
+// ---- Video flow control (NBT project 2026-11-19, see setDeferredVideoAcks) ------------------------------------------
+
+void AASession::setDeferredVideoAcks(bool on) { vack_on_ = on; }
+
+void AASession::postVideoConsumed(uint32_t frames) {
+    if (!frames) return;
+    pthread_mutex_lock(&vack_mutex_);
+    const bool on = vack_session_;
+    if (on) {
+        const uint32_t late = frames < vack_credit_ ? frames : vack_credit_;   // reports for frames acked by force
+        vack_credit_ -= late;
+        vack_consumed_ += frames - late;
+    }
+    pthread_mutex_unlock(&vack_mutex_);
+    if (on) wakeSessionThread();
+}
+
+bool AASession::videoAcksPending() {
+    pthread_mutex_lock(&vack_mutex_);
+    const bool p = vack_session_ && vack_outstanding_ > 0;
+    pthread_mutex_unlock(&vack_mutex_);
+    return p;
+}
+
+void AASession::drainVideoAcks() {
+    pthread_mutex_lock(&vack_mutex_);
+    if (!vack_session_ || !vack_outstanding_) {
+        pthread_mutex_unlock(&vack_mutex_);
+        return;
+    }
+    const double now = monoS();
+    uint32_t n = vack_consumed_ < vack_outstanding_ ? vack_consumed_ : vack_outstanding_;
+    vack_consumed_ -= n;
+    vack_outstanding_ -= n;
+    if (n && vack_outstanding_) vack_oldest_s_ = now;   // the rest arrived later than the ones just acked
+    uint32_t forced = 0;
+    if (vack_outstanding_ && now - vack_oldest_s_ >= vack_force_s_) {
+        forced = vack_outstanding_;
+        vack_credit_ += forced;
+        vack_outstanding_ = 0;
+        vack_forced_ += forced;
+        ++vack_force_runs_;
+    }
+    vack_acked_ += n + forced;
+    const uint32_t runs = vack_force_runs_, total_forced = vack_forced_, acked = vack_acked_;
+    bool stats = false;
+    if (now >= vack_stats_s_) {
+        stats = true;
+        vack_stats_s_ = now + 30;
+    }
+    pthread_mutex_unlock(&vack_mutex_);
+    if (forced && (runs <= 5 || runs % 50 == 0))
+        printf("[AASession] video: %u frame(s) not handed to the decoder for %.0f ms: acked anyway (%u times so far)\n",
+               forced, vack_force_s_ * 1000, runs);
+    if (stats)
+        printf("[AASession] video acks, session so far: %u acked, %u of them forced in %u runs\n", acked, total_forced,
+               runs);
+    for (uint32_t i = 0; i < n + forced; ++i) sendAvMediaAck(6);
 }
 
 void AASession::setUnderflowReports(bool on) { acks_.setUnderflowReports(on); }
