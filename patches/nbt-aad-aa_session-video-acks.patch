@@ -117,6 +117,16 @@ public:
     void setUnderflowReports(bool on);
     void postAudioUnderflow(uint8_t channel);
 
+    // Video flow control (NBT project 2026-11-19). On: a video frame (channel 6, AV_MEDIA_DATA) is acked only once the
+    // consumer reports it handed to the decoder or dropped (postVideoConsumed), so the phone can run at most the video
+    // window (10 frames) ahead of the decoder instead of filling a queue for seconds; a frame left unreported for
+    // NBT_AA_VIDEO_ACK_FORCE_MS (default 1500) is acked anyway (decoder stalled). Codec config is always acked on
+    // arrival. Off: acked on arrival. Set before start(); applies from the next session.
+    void setDeferredVideoAcks(bool on);
+    // The consumer took `frames` video frames, oldest first. Thread-safe (writer thread); acks go out from the session
+    // thread, woken through the wake pipe.
+    void postVideoConsumed(uint32_t frames);
+
 private:
     static void* sessionThreadStub(void* arg);
     void sessionLoop();
@@ -250,6 +260,18 @@ private:
     // session thread records frames into it and sends what it releases.
